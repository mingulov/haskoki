cabal-version:      3.0
name:               probe-main
version:            0.1.0.0
synopsis:           Out-of-tree probe: the main Haskell library must not resolve
license:            NONE
build-type:         Simple

-- Negative probe in its own project (separate solve universe:
-- Cabal solves a whole project before selecting targets, so
-- probes sharing a project cannot fail independently). Imports
-- the stub facade through the main library; must FAIL with a
-- dependency-resolution error. Pre-exposure-decision this
-- compiled pre-decision; post-decision it must not resolve.
executable probe
  main-is:          Main.hs
  build-depends:
    base    >= 4.14 && < 5,
    haskoki
  ghc-options:      -Wall
  default-language: GHC2024
