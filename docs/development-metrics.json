  "binding_rule": "The recorded session cwd, runtime workspace root, or Muse workspace_root is the Haskoki workspace or a descendant. Root and child-session directories are scanned; text mentions do not establish attribution.",
  "counting_method": {
    "Muse Code": "Sum runtime.session model_completed usage, globally deduplicated by record id. Every call is filtered by recorded_at, including calls in sessions started on earlier days.",
    "Codex": "Sum token_usage_record payload.usage, globally deduplicated by response_id and filtered by record timestamp. Join turn_id to turn_context for model identity.",
    "Excluded": "Cumulative counters, goal attribution records, workflow-child summaries, out-of-window calls, and sessions not bound to the project. Summaries are excluded rather than added to per-call usage; summary-only records are outside this count.",
    "Milestones": "Approximate phase attribution for Muse calls using consecutive timestamp intervals, inclusive start/exclusive end. Codex usage is reported separately, without assigning exclusive development roles."
  },
  "field_definitions": {
    "input_tokens": "Includes cached input.",
    "cached_tokens": "Subset of input served from cache; counted once.",
    "cache_write_tokens": "Observed zero in the counted calls.",
    "output_tokens": "Includes reasoning output.",
    "reasoning_tokens": "Subset of output, never added again.",
    "total_tokens": "input_tokens + output_tokens",
    "calls": "Individual recorded model responses, including failed requests, retries, planning, implementation, and review.",
    "claude_input_tokens": "Claude logs report input excluding cache reads and writes, so the reported input_tokens for Claude rows is raw input plus cache_read plus cache_write; cached_tokens is the cache_read part and cache_write_tokens the cache_write part, and total_tokens is that input plus output_tokens, the same as for every harness."
  },
