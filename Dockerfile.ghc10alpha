# haskoki toolchain image: GHC 10.0.1-alpha1 ALTERNATIVE.
#
# The default toolchain image is Dockerfile (GHC 9.10.3 from OS
# packages). This file preserves the pre-flip alpha environment:
# Ubuntu 26.04, GHC 10.0.1-alpha1 via the ghcup prereleases channel,
# pinned cabal-install, project deps prebuilt.
#
#   Build (from this directory):  docker build -f Dockerfile.ghc10alpha -t haskoki-dev:ghc-10.0.0.20260917 .
#   Shell with repo mounted:      docker run --rm -it -v "$PWD:/work" -w /work haskoki-dev:ghc-10.0.0.20260917
#   Transfer to another machine:  docker save haskoki-dev:ghc-10.0.0.20260917 | zstd > haskoki-dev-alpha.tar.zst
#                                 (elsewhere) docker load < haskoki-dev-alpha.tar.zst
#
# Pinned versions live in the ARG block below; the alpha build plan
# is cabal.project.ghc10alpha(.freeze). See docs/toolchain.md.
ARG GHC_VERSION=10.0.0.20260917
ARG CABAL_VERSION=3.18.1.0
# 26.04 base already ships user ubuntu (1000:1000); defaults reuse it so
# bind-mounted files keep host ownership. For other ids pass e.g.
# --build-arg USERNAME=dev --build-arg UID=2000 --build-arg GID=2000.
ARG USERNAME=ubuntu
ARG UID=1000
ARG GID=1000
# T07: pinned libcrypto for the OpenSSL4 backend (see toolchain.lock
# [openssl]; haskoki.cabal hardcodes OPENSSL_PREFIX below because the
# .cabal format has no env substitution).
ARG OPENSSL_VERSION=4.0.2
ARG OPENSSL_SHA256=736b467530f916737b7031310ccb21d8218c6229e61e8e160cd1d3458cd543a8
ARG OPENSSL_PREFIX=/opt/openssl-4.0.2

# Pinned OpenSSL 4.0.2 (libcrypto for the OpenSSL4 backend).
FROM ubuntu:26.04 AS openssl-build
ARG OPENSSL_VERSION OPENSSL_SHA256 OPENSSL_PREFIX
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential perl ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /tmp/ossl-build
RUN curl -fsSLO "https://github.com/openssl/openssl/releases/download/openssl-${OPENSSL_VERSION}/openssl-${OPENSSL_VERSION}.tar.gz" \
 && echo "${OPENSSL_SHA256}  openssl-${OPENSSL_VERSION}.tar.gz" | sha256sum -c - \
 && tar xzf "openssl-${OPENSSL_VERSION}.tar.gz" \
 && cd "openssl-${OPENSSL_VERSION}" \
 && perl ./Configure --prefix="${OPENSSL_PREFIX}" --openssldir="${OPENSSL_PREFIX}/ssl" \
      --libdir=lib no-docs no-tests threads no-shared no-pinshared linux-x86_64 \
 && make -j"$(nproc)" \
 && make install_sw \
 && rm -rf /tmp/ossl-build/openssl-${OPENSSL_VERSION} \
 && "${OPENSSL_PREFIX}/bin/openssl" version

FROM ubuntu:26.04

ARG GHC_VERSION
ARG CABAL_VERSION
ARG USERNAME
ARG UID
ARG GID

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# System deps: toolchain to run GHC bindists + downloader for ghcup.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential curl ca-certificates git \
      libffi-dev libgmp-dev libncurses-dev pkg-config \
      xz-utils perl \
    && rm -rf /var/lib/apt/lists/*

# Non-root dev user (create only when the base image lacks it).
RUN if ! getent passwd "$USERNAME" >/dev/null; then \
      getent group "$GID" || groupadd -g "$GID" "$USERNAME"; \
      useradd -m -u "$UID" -g "$GID" -s /bin/bash "$USERNAME"; \
    fi
USER $USERNAME
ENV HOME=/home/$USERNAME \
    PATH=/home/$USERNAME/.ghcup/bin:/home/$USERNAME/.cabal/bin:$PATH
WORKDIR /home/$USERNAME

# ghcup first (minimal: no default toolchain), then the pinned tools.
# The prereleases channel carries the GHC 10 snapshot; Ubuntu >= 24
# resolves to the purpose-built ubuntu24_04 bindist, which runs on the
# newer glibc of 26.04. Fallback if the channel ever fails:
#   ghcup install ghc -u \
#     https://downloads.haskell.org/~ghc/10.0.0.20260917/ghc-10.0.0.20260917-x86_64-ubuntu24_04-linux.tar.xz \
#     "$GHC_VERSION" --set
RUN BOOTSTRAP_HASKELL_NONINTERACTIVE=1 BOOTSTRAP_HASKELL_MINIMAL=1 \
      curl --proto '=https' --tlsv1.2 -sSf https://get-ghcup.haskell.org | sh \
 && ghcup install cabal "$CABAL_VERSION" --set \
 && ghcup -s prereleases install ghc "$GHC_VERSION" --set \
 && ghc --numeric-version && cabal --numeric-version \
 && rm -rf ~/.ghcup/cache ~/.ghcup/tmp ~/.ghcup/logs ~/.ghcup/trash ~/.ghcup/stack \
 && rm -rf ~/.ghcup/ghc/"$GHC_VERSION"/share/doc

# T07: pinned libcrypto prefix for the OpenSSL4 backend build.
COPY --from=openssl-build /opt/openssl-4.0.2 /opt/openssl-4.0.2
ENV OPENSSL4_PREFIX=/opt/openssl-4.0.2

# Project layer: copy the package, fetch Hackage index, build + test so the
# image carries compiled deps and works offline on the next machine.
# (T07: added the core/ffi/cbits/tests/spec/scripts trees the suites need;
# the T00-era src/+test/-only list no longer builds.)
WORKDIR /work
COPY --chown=$UID:$GID haskoki.cabal Setup.hs ./
COPY --chown=$UID:$GID cabal.project.ghc10alpha ./cabal.project
COPY --chown=$UID:$GID cabal.project.ghc10alpha.freeze ./cabal.project.freeze
COPY --chown=$UID:$GID toolchain.lock toolchain.lock
COPY --chown=$UID:$GID README.md CHANGELOG.md ./
COPY --chown=$UID:$GID src/ src/
COPY --chown=$UID:$GID core/ core/
COPY --chown=$UID:$GID ffi/ ffi/
COPY --chown=$UID:$GID cbits/ cbits/
COPY --chown=$UID:$GID test/ test/
COPY --chown=$UID:$GID tests/ tests/
COPY --chown=$UID:$GID spec/ spec/
COPY --chown=$UID:$GID scripts/ scripts/
COPY --chown=$UID:$GID app/ app/
COPY --chown=$UID:$GID tools/ tools/
COPY --chown=$UID:$GID docs/ docs/
# Build before testing: a fresh `cabal test all` can run haskoki-core-tests
# before the sibling main library unit registers (Cabal-9341); the
# explicit build first is the same workaround scripts/run-gates.sh uses.
RUN cabal update && cabal build all --enable-tests && cabal test all

CMD ["/bin/bash"]
