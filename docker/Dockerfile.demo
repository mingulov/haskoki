# haskoki demo image: self-contained bundle + proxy + checker + entrypoint.
#
# Multi-stage build; the bundle is STAGED before the build (R8/D1):
# scripts/test-demo-image.sh builds scripts/make-release.sh once
# (or consumes the CI release-bundle artifact), and the runtime
# stage COPYs that staged tree (staged-bundle/) — the image never
# builds a second bundle from source.
#
#   Build (from repo root; the driver stages first — see above):
#     docker build -f docker/Dockerfile.demo -t haskoki-demo:0.3.0.0 .
#     docker build -f docker/Dockerfile.demo -t haskoki-demo:0.3.0.0 \
#       --build-arg PROXY_REF=v0.2.2 .
#
#   Run (runtime scenarios run --network none; the proxy stays on
#   loopback, which needs no external network):
#     docker run --rm -v "$PWD/out:/out" haskoki-demo:0.3.0.0 demo
#     docker run --rm --network none -v "$PWD/out:/out" haskoki-demo:0.3.0.0 \
#       check --mode direct --profile smoke
#
# Stages: proxy (pinned Rust recipe from
# scripts/test-proxy-parity.sh, PROXY_REF default v0.2.2); checker
# (pkcs11-check v0.2.3 + pkcs11-tool); runtime (slim: staged bundle
# tree + proxy binaries + checker + entrypoint ONLY, no toolchains).
#
# Checker profiles are FROZEN (R4); the compare parity subset is FROZEN
# (R5; classified by the shipped examples/release/compare-classify
# wrapper, enforced by scripts/test-demo-image.sh); the entrypoint
# help text says so.
#
# Build-time network is used for fetches (apt, crates.io, PyPI, git);
# RUNTIME scenarios run --network none.
#
# Identity labels (R8): the runtime stage carries OCI
# source/version/revision/licenses labels. Plain local builds
# leave REVISION=unknown (honest: .git is dockerignored, so the
# build cannot see the SHA); release-candidate builds pass
# --build-arg REVISION=<source SHA> (CI publish path does).
# The image never contains its own final digest.
ARG VERSION=0.3.0.0
ARG REVISION=unknown
ARG SOURCE=https://github.com/mingulov/haskoki

# ---------------------------------------------------------------------------
# No bundle stage: the bundle is staged BEFORE the build (R8/D1) and
# consumed via COPY in the runtime stage below. Staging is owned by
# scripts/test-demo-image.sh (local: runs make-release.sh in the
# toolchain container; CI: consumes the release-bundle artifact).
# The runtime self-test asserts the staged tree's shape.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Stage: proxy. Pinned-toolchain build of daemon + shim.
# Recipe EXACTLY per scripts/test-proxy-parity.sh header (canonical build):
#   rust:1.94-bookworm + apt-get install protobuf-compiler
#   + cargo build --release, from a pristine checkout at PROXY_REF.
# git + ca-certificates are fetch-time only (clone + checkout); the
# BUILD recipe above is the pinned one verbatim.
# ---------------------------------------------------------------------------
FROM rust:1.94-bookworm AS proxy

ARG PROXY_REF=v0.2.2

# Canonical artifact hashes for the release pin, quoted from
# scripts/test-proxy-parity.sh ("Canonical build (the ONLY authoritative
# hashes)"). Asserted when the build ref resolves to that commit; any
# other ref records its hashes without asserting.
# R9: pin is pkcs11-proxy-ng v0.2.2 (tag v0.2.2 = commit 1ed7cc15…;
# parity 70 holds; checker-lane re-qualification + known deltas
# recorded in the R9 report before this pin commits).
# v0.2.1 was attempted and REJECTED (upstream #35 visibility loss,
# #36 cert-find hole, #37 daemon death on message params — the last
# blocks all full proxy checker lanes); v0.2.0 was the R5 pin.
ENV PROXY_CANON_COMMIT=1ed7cc15c838de2e56ba03ac34f426847ffce049
ENV PROXY_CANON_DAEMON=91d9ccba8e579891fb5a8815f66518baef0a757bd9a2563097983ca9d056385b
ENV PROXY_CANON_SHIM=87eb3f651c82de637e30666f305fae540375680bc754cf76249e17b6e7cb1d75

RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates protobuf-compiler \
    && rm -rf /var/lib/apt/lists/* \
    && git clone https://github.com/mingulov/pkcs11-proxy-ng.git /src \
    && cd /src \
    && git checkout "$PROXY_REF" \
    && cargo build --release \
    && mkdir -p /out/proxy \
    && cp target/release/pkcs11-proxy-ng \
         target/release/libpkcs11_proxy_ng_shim.so /out/proxy/ \
    && cp LICENSE-APACHE LICENSE-MIT /out/proxy/ \
    && COMMIT=$(git rev-parse HEAD) \
    && { echo "source = https://github.com/mingulov/pkcs11-proxy-ng"; \
         echo "ref = $PROXY_REF"; \
         echo "commit = $COMMIT"; \
         echo "subject = $(git log -1 --format=%s)"; \
         echo "recipe = rust:1.94-bookworm + apt-get install protobuf-compiler + cargo build --release (scripts/test-proxy-parity.sh header)"; \
         echo -n "daemon sha256 = "; sha256sum /out/proxy/pkcs11-proxy-ng | awk '{print $1}'; \
         echo -n "shim sha256 = "; sha256sum /out/proxy/libpkcs11_proxy_ng_shim.so | awk '{print $1}'; \
       } > /out/proxy/PROVENANCE \
    && cat /out/proxy/PROVENANCE \
    && if [ "$COMMIT" = "$PROXY_CANON_COMMIT" ]; then \
         (cd /out/proxy && echo "$PROXY_CANON_DAEMON  pkcs11-proxy-ng" | sha256sum -c -) \
         && (cd /out/proxy && echo "$PROXY_CANON_SHIM  libpkcs11_proxy_ng_shim.so" | sha256sum -c -) \
         && echo "proxy provenance: canonical pair reproduced"; \
       else \
         echo "proxy provenance: non-canonical ref, hashes recorded, not asserted"; \
       fi \
    && /out/proxy/pkcs11-proxy-ng --version \
    && nm -D --defined-only /out/proxy/libpkcs11_proxy_ng_shim.so | grep -q " T C_GetFunctionList$" \
    && nm -D --defined-only /out/proxy/libpkcs11_proxy_ng_shim.so | grep -q " T C_GetInterface$" \
    && nm -D --defined-only /out/proxy/libpkcs11_proxy_ng_shim.so | grep -q " T C_GetInterfaceList$" \
    && echo "proxy static checks: daemon runs, shim exports discovery surface"

# ---------------------------------------------------------------------------
# Stage: checker. pkcs11-check v0.2.3 (venv) + pkcs11-tool (opensc).
# ---------------------------------------------------------------------------
FROM ubuntu:26.04 AS checker

ENV DEBIAN_FRONTEND=noninteractive

# Every package documented: python3 + python3-venv + python3-pip build
# the checker venv; opensc provides the pkcs11-tool client;
# ca-certificates lets pip/apt fetch over TLS at build time.
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-venv python3-pip opensc ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/p11c \
    && /opt/p11c/bin/pip install --no-input "pkcs11-check==0.2.3" \
    && /opt/p11c/bin/pkcs11-check version | grep -q 'pkcs11-check 0\.2\.3$' \
    && /opt/p11c/bin/pip freeze > /opt/p11c/freeze.txt \
    && { echo "pkcs11-check = 0.2.3 (PyPI pin)"; \
         echo -n "python3 = "; python3 --version; \
         echo -n "opensc = "; dpkg-query -W -f='${Version}' opensc; echo; \
       } > /opt/p11c/versions.txt \
    && cat /opt/p11c/versions.txt \
    && command -v pkcs11-tool

# ---------------------------------------------------------------------------
# Stage: runtime. Slim: bundle tree + proxy binaries + checker + entrypoint
# ONLY. No GHC/Cabal/Rust toolchains.
# ---------------------------------------------------------------------------
FROM ubuntu:26.04 AS runtime

# Re-declare the global identity args so this stage can use them.
ARG VERSION
ARG REVISION
ARG SOURCE
LABEL org.opencontainers.image.title="haskoki-demo" \
      org.opencontainers.image.description="Haskoki PKCS#11 soft-token demo: bundle + pinned proxy + external checker" \
      org.opencontainers.image.source="${SOURCE}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.licenses="Apache-2.0"

ENV DEBIAN_FRONTEND=noninteractive

# Every package documented: libgmp10 + libffi8 + libnuma1 are the bundle's
# host runtime libs (R2 native proof); opensc provides pkcs11-tool for the
# demo and examples; python3 runs the checker venv (/opt/p11c symlinks to
# /usr/bin/python3, same base image as the checker stage);
# ca-certificates lets fetch-data download vectors over TLS at runtime
# (R4: without it every fetch fails with CERTIFICATE_VERIFY_FAILED).
RUN apt-get update && apt-get install -y --no-install-recommends \
      libgmp10 libffi8 libnuma1 opensc python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Staged bundle tree (built once before this build; see the header).
# The self-test below asserts its shape — a missing or partial
# staged-bundle/ fails here, never silently.
COPY staged-bundle/ /opt/haskoki/dist-release/
COPY --from=proxy /out/proxy/ /opt/haskoki/proxy/
COPY --from=checker /opt/p11c/ /opt/p11c/
COPY docker/haskoki-demo /usr/local/bin/haskoki-demo
COPY examples/release/ /opt/haskoki/examples/release/

RUN chmod +x /usr/local/bin/haskoki-demo \
    && test "$(ls -d /opt/haskoki/dist-release/haskoki-* | wc -l)" -eq 1 \
    && ART=$(echo /opt/haskoki/dist-release/haskoki-*) && test -d "$ART" \
    && test -f "$ART/lib/libhaskoki.so" \
    && test -x "$ART/bin/haskoki-ctl" \
    && test -f "$ART/lib/ossl-modules/legacy.so" \
    && test "$(ls "$ART"/lib/libHS*.so | wc -l)" -gt 0 \
    && test -f "$ART/licenses/Haskoki-LICENSE" \
    && test -f "$ART/licenses/OpenSSL-LICENSE.txt" \
    && test -f "$ART/licenses/GHC-copyright" \
    && test -f "$ART/licenses/NOTICES.md" \
    && test -f "$ART/closure/review.txt" \
    && grep -q 'libcrypto: STATIC' "$ART/closure/review.txt" \
    && grep -q 'provider (shipped, $ORIGIN-anchored)' "$ART/closure/review.txt" \
    && grep -q 'bundled GHC/store libs' "$ART/closure/review.txt" \
    && test -f "$ART/toolchain-record.txt" \
    && test -f "$ART/INSTALL.md" \
    && SO="$ART/lib/libhaskoki.so" \
    && ldd "$SO" > /tmp/ldd-so.txt 2>&1 \
    && ! grep -q "not found" /tmp/ldd-so.txt \
    && /opt/p11c/bin/pkcs11-check version | grep -q 'pkcs11-check 0\.2\.3$' \
    && command -v pkcs11-tool \
    && test -f /etc/ssl/certs/ca-certificates.crt \
    && test -f /opt/haskoki/proxy/LICENSE-APACHE \
    && test -f /opt/haskoki/proxy/LICENSE-MIT \
    && haskoki-demo --help > /dev/null \
    && echo "runtime self-test: staged bundle verified, checker + pkcs11-tool + CA store + proxy licenses present"

ENTRYPOINT ["/usr/local/bin/haskoki-demo"]
CMD ["demo"]
