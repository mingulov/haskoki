#!/bin/sh
# docker/haskoki-demo -- demo image entrypoint (demo | check | compare).
#
# Self-contained operator CLI over the in-image bundle + proxy + checker:
#   demo                  keygen, sign/verify + encrypt/decrypt of fixed
#                         PUBLIC fixtures (default command)
#   check --mode M --profile P
#                         run pkcs11-check (doctor gate + test lane)
#   compare               run the full profile direct vs proxied and diff
#                         per-test verdict transcripts
#
# Exit-code contract (exact): 0 healthy / 1 findings or unexpected diffs
# / 2 usage-or-infrastructure failure. Every command writes a unique run
# directory under /out with machine-readable reports (report.json plus
# tool-native artifacts). --output json|text selects the stdout rendering
# (default text); report files are always written.
#
# PROVISIONAL (R4/R5 freeze; see examples/release/pkcs11-check/README):
# smoke profile selection, full profile scope, compare subset (= all).
# Demo PINs/seeds/labels are PUBLIC fixtures (values never logged).
#
# Arbitrary-UID safe: writes only under the run dir (inside /out);
# no root-only paths, no HOME writes.
set -u

VERSION="0.3.0.0"
BUNDLE_ROOT="/opt/haskoki/dist-release"
PROXY_DIR="/opt/haskoki/proxy"
CHECKER="/opt/p11c/bin/pkcs11-check"
EXAMPLES="/opt/haskoki/examples/release"
PROFILES="$EXAMPLES/pkcs11-check/profiles.conf"
OUT_DEFAULT="/out"

# ---------------------------------------------------------------------------
# Help
# ---------------------------------------------------------------------------

