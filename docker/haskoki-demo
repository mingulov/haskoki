# check
# ---------------------------------------------------------------------------

# Profiles (PROVISIONAL): sourced from the shipped examples so the file
# R4 freezes is the file this command reads.
load_profiles() {
  [ -f "$PROFILES" ] || { echo "haskoki-demo: profiles missing: $PROFILES" >&2; return 1; }
  # shellcheck disable=SC1090
  . "$PROFILES"
  [ -n "${SMOKE_MARKER:-}" ] || { echo "haskoki-demo: SMOKE_MARKER empty" >&2; return 1; }
  [ -n "${SMOKE_MATCH:-}" ] || { echo "haskoki-demo: SMOKE_MATCH empty" >&2; return 1; }
  [ -n "${FULL_MARKER:-}" ] || { echo "haskoki-demo: FULL_MARKER empty" >&2; return 1; }
  : "${FULL_MATCH:-}"
  : "${CHECK_TIMEOUT:=180}"
  : "${CHECK_SLOT:=0}"
}

check_backend() {
  # $1 = run dir; prints backend path (memory store for checker lanes:
  # the checker manages its own keys per test; nothing must persist).
  run="$1"
  src="$EXAMPLES/pkcs11-check/backend-memory.toml"
  [ -f "$src" ] || { echo "haskoki-demo: backend template missing: $src" >&2; return 1; }
  cp "$src" "$run/backend.toml" || return 1
  echo "$run/backend.toml"
}

DAEMON_PID=""

daemon_stop() {
  if [ -n "${DAEMON_PID:-}" ]; then
    kill "$DAEMON_PID" 2>/dev/null || true
    wait "$DAEMON_PID" 2>/dev/null || true
    DAEMON_PID=""
  fi
}

daemon_start() {
  # $1 = run dir, $2 = module path; sets DAEMON_PID; proxy.toml + log in run dir.
  run="$1"; mod="$2"
  port="${HASKOKI_DEMO_PROXY_PORT:-17512}"
  bin="$PROXY_DIR/pkcs11-proxy-ng"
  [ -x "$bin" ] || { echo "haskoki-demo: proxy daemon missing: $bin" >&2; return 1; }
  if tcp_accepts "$port"; then
    echo "haskoki-demo: proxy port $port already busy (one run at a time)" >&2
    return 1
  fi
  # Daemon config mirrors scripts/test-proxy-parity.sh (loopback dev
  # shape): transparent discovery, loopback bind, no auth. HASKOKI_CONFIG
  # selects the daemon-side backend (memory store, real crypto).
  cat > "$run/proxy.toml" <<EOF
[backend]
module = "$mod"

[proxy]
mechanism_discovery = "transparent"
lease_seconds = 600
request_timeout_secs = 60
max_concurrent_backend_calls = 200
max_blocking_threads = 512

[listener.remote]
bind = "127.0.0.1:$port"
auth = "none"
allow_insecure_tcp = true
EOF
  HASKOKI_CONFIG="$run/backend.toml" RUST_LOG=info "$bin" "$run/proxy.toml" \
    >> "$run/daemon.log" 2>&1 &
  DAEMON_PID=$!
  # Readiness: TCP accept on the loopback port (the daemon binds only
  # after the backend loads, so accept means ready). 30s gate.
  i=0
  while [ "$i" -lt 30 ]; do
    if ! kill -0 "$DAEMON_PID" 2>/dev/null; then
      echo "haskoki-demo: proxy daemon died during startup (see $run/daemon.log)" >&2
      DAEMON_PID=""
      return 1
    fi
    if tcp_accepts "$port"; then
      say "proxy daemon ready: 127.0.0.1:$port (pid $DAEMON_PID)"
      return 0
    fi
    i=$((i + 1))
    sleep 1
  done
  echo "haskoki-demo: proxy daemon not listening after 30s (see $run/daemon.log)" >&2
  daemon_stop
  return 1
}

# One checker lane inside an existing run dir. Sets globals:
# LANE_RC (native checker exit), LANE_FINDINGS (summary count),
# LANE_LISTED (per-test rows written), LANE_CHILD_UNITS (worker-unit
# counters), LANE_INCOMPLETE.
LANE_RC=0
LANE_FINDINGS=0
LANE_LISTED=0
LANE_CHILD_UNITS=0
LANE_INCOMPLETE=0

run_lane() {
  # $1 run dir, $2 mode, $3 profile, $4 marker, $5 match (may be empty)
  # Locals: compare calls this twice and must keep its own $run.
  local run mode profile marker match art SO backend MOD SHIM port rc bin i
  run="$1"; mode="$2"; profile="$3"; marker="$4"; match="$5"
  art=$(bundle_dir) || return 2
  SO="$art/lib/libhaskoki.so"
  [ -f "$SO" ] || { echo "haskoki-demo: module missing: $SO" >&2; return 2; }
  [ -x "$CHECKER" ] || { echo "haskoki-demo: checker missing: $CHECKER" >&2; return 2; }
  backend=$(check_backend "$run") || return 2

  MOD="$SO"
  if [ "$mode" = "proxy" ]; then
    SHIM="$PROXY_DIR/libpkcs11_proxy_ng_shim.so"
    [ -f "$SHIM" ] || { echo "haskoki-demo: proxy shim missing: $SHIM" >&2; return 2; }
    daemon_start "$run" "$SO" || return 2
    port="${HASKOKI_DEMO_PROXY_PORT:-17512}"
    export PKCS11_PROXY_ENDPOINT="http://127.0.0.1:$port"
    MOD="$SHIM"
  fi

  # PINs via env (never on argv, never in logs). PUBLIC fixtures.
  export P11TEST_PIN="1234"
  export P11TEST_SO_PIN="5678"
  # No bytecode writes outside the run dir (arbitrary-UID safe:
  # site-packages may be read-only for the invoker).
  export PYTHONDONTWRITEBYTECODE=1
  export PYTHONPYCACHEPREFIX="$run/pycache"

  say "doctor: $CHECKER doctor --module <...>"
  if [ "$mode" = "proxy" ]; then
    "$CHECKER" doctor --module "$MOD" --slot "$CHECK_SLOT" \
      > "$run/doctor.out" 2> "$run/doctor.err"
  else
    HASKOKI_CONFIG="$backend" "$CHECKER" doctor --module "$MOD" --slot "$CHECK_SLOT" \
      > "$run/doctor.out" 2> "$run/doctor.err"
  fi
  rc=$?
  cat "$run/doctor.out" "$run/doctor.err" > "$run/checker.log"
  if [ $rc -ne 0 ]; then
    echo "doctor refused (rc=$rc); see $run/doctor.out/err" >&2
    [ "$mode" = "proxy" ] && daemon_stop
    return 2
  fi
  say "doctor: healthy"

  say "test [$mode/$profile]: marker + match from $PROFILES"
  # Optional --match as separate argv (no word-splitting tricks).
  set -- --module "$MOD" --slot "$CHECK_SLOT" \
      --isolation auto --timeout "$CHECK_TIMEOUT" \
      --state-file "$run/state.json" --policy-file "$run/policy.json" \
      --marker "$marker"
  if [ -n "$match" ]; then
    set -- "$@" --match "$match"
  fi
  set -- "$@" --output json --output-file "$run/results.json"
  if [ "$mode" = "proxy" ]; then
    ( cd "$run" && "$CHECKER" test "$@" >> "$run/checker.log" 2>&1 )
  else
    ( cd "$run" && HASKOKI_CONFIG="$backend" "$CHECKER" test "$@" >> "$run/checker.log" 2>&1 )
  fi
  LANE_RC=$?
  say "checker native exit: $LANE_RC (preserved in report)"
  [ "$mode" = "proxy" ] && daemon_stop

  if [ "$LANE_RC" -ge 2 ]; then
    echo "checker setup error (rc=$LANE_RC); see $run/checker.log" >&2
    return 2
  fi
  [ -f "$run/results.json" ] || { echo "haskoki-demo: results.json missing" >&2; return 2; }
  [ -f "$run/report.jsonl" ] || { echo "haskoki-demo: report.jsonl missing" >&2; return 2; }

  # Verdict from the summary + per-test finding ids from report.jsonl
  # (stable ids: venv path prefix stripped up to testcases/). A parse
  # failure must never pass as healthy: stale LANE_* would lie.
  # Verdict mapping (same rules as compare): call outcome wins; a
  # setup-phase terminal outcome without a call record maps as itself
  # (failed/error/skipped); setup-passed without a call record means
  # the worker died (crashed); an explicit failed/error teardown
  # surfaces unless the call record already carries a finding;
  # unknown outcomes map to the finding side.
  lane_eval=""
  lane_eval=$(python3 - "$run/results.json" "$run/report.jsonl" "$run/findings.txt" <<'PY'
import json, sys
results, report, out = sys.argv[1], sys.argv[2], sys.argv[3]
s = json.load(open(results))["summary"]
keys = ("failed", "error", "crashed", "timeout", "crash_limited",
        "xpassed", "child_crash", "child_timeout")
findings = sum(int(s.get(k, 0)) for k in keys)
incomplete = bool(s.get("incomplete", False))
setup, call, teardown = {}, {}, {}
bad_lines = 0
for raw in open(report):
    if not raw.strip():
        bad_lines += 1
        continue
    try:
        e = json.loads(raw)
    except ValueError:
        bad_lines += 1
        continue
    if e.get("$report_type") != "TestReport":
        continue
    nid = (e.get("nodeid") or "").split("testcases/")[-1]
    if not nid:
        bad_lines += 1
        continue
    when, outcome = e.get("when"), e.get("outcome") or "?"
    if when == "setup":
        setup[nid] = outcome
    elif when == "call":
        call[nid] = outcome
    elif when == "teardown":
        teardown[nid] = outcome
if bad_lines:
    print("haskoki-demo: %d malformed/blank jsonl lines in %s"
          % (bad_lines, report), file=sys.stderr)
    sys.exit(2)
verdicts = dict(call)
for nid, outcome in setup.items():
    if nid not in verdicts:
        if outcome == "passed":
            verdicts[nid] = "crashed"
        elif outcome in ("failed", "error", "skipped"):
            verdicts[nid] = outcome
        else:
            verdicts[nid] = "crashed"
for nid, outcome in teardown.items():
    # Explicit teardown failures surface unless the call record
    # already carries an explicit finding (which wins as primary);
    # in particular they override passed/skipped verdicts, absent
    # records, unknown outcomes, and setup-inferred crashes.
    if outcome in ("failed", "error") and call.get(nid) not in (
            "failed", "error", "crashed", "timeout", "xpassed"):
        verdicts[nid] = outcome
rows = []
for nid in sorted(verdicts):
    o = verdicts[nid]
    if o not in ("passed", "skipped"):
        rows.append(("crashed" if o == "?" else o, nid))
with open(out, "w") as f:
    for o, nid in sorted(rows):
        f.write("%s %s\n" % (o, nid))
print("LANE_FINDINGS=%d" % findings)
print("LANE_LISTED=%d" % len(rows))
print("LANE_CHILD_UNITS=%d" % (int(s.get("child_crash", 0)) +
                               int(s.get("child_timeout", 0))))
print("LANE_INCOMPLETE=%d" % (1 if incomplete else 0))
PY
)
  py_rc=$?
  if [ "$py_rc" -ne 0 ]; then
    echo "haskoki-demo: verdict parse failed (see above)" >&2
    return 2
  fi
  if [ -z "$lane_eval" ]; then
    echo "haskoki-demo: verdict parse produced nothing (see $run/checker.log)" >&2
    return 2
  fi
  eval "$lane_eval"
  # Reconciliation: every summary finding must be listed (child_crash /
  # child_timeout are worker-unit counters without per-test records and
  # stay summary-only; anything else unlisted is a mapping gap).
  listed_want=$((LANE_FINDINGS - LANE_CHILD_UNITS))
  if [ "$LANE_LISTED" -ne "$listed_want" ]; then
    echo "haskoki-demo: listed $LANE_LISTED findings but summary has $listed_want (mapping gap)" >&2
    return 2
  fi
  if [ "$LANE_INCOMPLETE" -eq 1 ]; then
    echo "checker run incomplete; see $run/checker.log" >&2
    return 2
  fi
  # Native-status consistency: rc 0 means zero findings, rc 1 means
  # some; any other combination is a verdict bug — fail loudly.
  if [ "$LANE_RC" -eq 0 ] && [ "$LANE_FINDINGS" -ne 0 ]; then
    echo "haskoki-demo: checker rc=0 but $LANE_FINDINGS findings parsed" >&2
    return 2
  fi
  if [ "$LANE_RC" -eq 1 ] && [ "$LANE_FINDINGS" -eq 0 ]; then
    echo "haskoki-demo: checker rc=1 but zero findings parsed" >&2
    return 2
  fi
  return 0
}

cmd_check() {
  # $1 = output mode, $2 = mode, $3 = profile
  outmode="$1"; OUTMODE="$1"; mode="$2"; profile="$3"
  started=$(utc_now)
  load_profiles || return 2
  case "$mode/$profile" in
    direct/smoke|direct/full|proxy/smoke|proxy/full) ;;
    *) echo "haskoki-demo: check needs --mode direct|proxy --profile smoke|full" >&2; return 2 ;;
  esac
  art=$(bundle_dir) || return 2
  run=$(make_run_dir "check-$mode-$profile") || return 2
  say "run dir: $run"

  if [ "$profile" = "smoke" ]; then
    marker="$SMOKE_MARKER"; match="$SMOKE_MATCH"
  else
    marker="$FULL_MARKER"; match="$FULL_MATCH"
  fi
  trap daemon_stop EXIT
  trap 'daemon_stop; exit 143' INT TERM
  run_lane "$run" "$mode" "$profile" "$marker" "$match"
  rc=$?
  daemon_stop
  if [ $rc -eq 2 ]; then
    return 2
  fi

  finished=$(utc_now)
  tool_versions
  exitcode=0
  [ "$LANE_FINDINGS" -gt 0 ] && exitcode=1
  # Report writer takes scalars via argv and reads the artifacts itself:
  # no JSON is ever interpolated into Python source.
  python3 - "$run" "$mode" "$profile" "$started" "$finished" "$exitcode" \
    "$art" "$LANE_RC" "$CHECKER_VER" "$PY_VER" "$marker" "$match" \
    "$LANE_FINDINGS" "$VERSION" <<'PY'
import json, sys
(run, mode, profile, started, finished, exitcode, art, lane_rc,
 checker_ver, py_ver, marker, match, findings_n, version) = sys.argv[1:15]
summary = json.load(open(run + "/results.json"))["summary"]
findings = []
for line in open(run + "/findings.txt"):
    line = line.rstrip("\n")
    if line:
        o, _, nid = line.partition(" ")
        findings.append({"outcome": o, "test": nid})
report = {
    "command": "check",
    "mode": mode,
    "profile": profile,
    "profile_status": "provisional (R4 freezes)",
    "entrypoint": "haskoki-demo " + version,
    "started_utc": started,
    "finished_utc": finished,
    "exit_code": int(exitcode),
    "run_dir": run,
    "bundle": art,
    "checker_native_exit": int(lane_rc),
    "tools": {"checker": checker_ver, "python3": py_ver},
    "selection": {"marker": marker, "match": match},
    "summary": summary,
    "findings_count": int(findings_n),
    "findings": findings,
}
json.dump(report, open(run + "/report.json", "w"), indent=1)
PY
  py_rc=$?
  if [ "$py_rc" -ne 0 ]; then
    echo "haskoki-demo: cannot write report.json" >&2
    return 2
  fi

  if [ "$outmode" = "json" ]; then
    cat "$run/report.json"
  else
    echo "check summary [$mode/$profile] ($run):"
    echo "  checker native exit: $LANE_RC"
    if [ "$LANE_FINDINGS" -eq 0 ]; then
      echo "  findings: none"
      echo "check-ok: zero findings; report: $run/report.json"
    else
      echo "  findings ($LANE_FINDINGS):"
      sed 's/^/    /' "$run/findings.txt"
      echo "check-FINDINGS: $LANE_FINDINGS finding(s); report: $run/report.json"
    fi
  fi
  return "$exitcode"
}

# ---------------------------------------------------------------------------
# compare
# ---------------------------------------------------------------------------

cmd_compare() {
  # $1 = output mode
  outmode="$1"; OUTMODE="$1"
  started=$(utc_now)
  load_profiles || return 2
  art=$(bundle_dir) || return 2
  run=$(make_run_dir compare) || return 2
  say "run dir: $run"
  mkdir -p "$run/direct" "$run/proxy" || return 2

  trap daemon_stop EXIT
  trap 'daemon_stop; exit 143' INT TERM
  say "--- sub-run: direct/full ---"
  run_lane "$run/direct" direct full "$FULL_MARKER" "$FULL_MATCH"
  rc1=$?
  say "--- sub-run: proxy/full ---"
  run_lane "$run/proxy" proxy full "$FULL_MARKER" "$FULL_MATCH"
  rc2=$?
  daemon_stop
  if [ $rc1 -eq 2 ] || [ $rc2 -eq 2 ]; then
    echo "haskoki-demo: compare sub-run infrastructure failure" >&2
    return 2
  fi

  # Verdict-map diff (stable ids; same mapping rules as check:
  # call wins, setup-terminal without call maps as itself, setup-passed
  # without call = crashed, explicit failed/error teardown
  # surfaces unless the call record already carries a finding,
  # unknown outcomes map to the finding side).
  python3 - "$run/direct/report.jsonl" "$run/proxy/report.jsonl" \
    "$run/diff.txt" "$run/shared-findings.txt" <<'PY'
import json, sys
djsonl, pjsonl, diffout, sharedout = sys.argv[1:5]

def verdicts(path):
    setup, call, teardown = {}, {}, {}
    bad_lines = 0
    with open(path) as f:
        for raw in f:
            if not raw.strip():
                bad_lines += 1
                continue
            try:
                e = json.loads(raw)
            except ValueError:
                bad_lines += 1
                continue
            if e.get("$report_type") != "TestReport":
                continue
            nid = (e.get("nodeid") or "").split("testcases/")[-1]
            if not nid:
                bad_lines += 1
                continue
            when, outcome = e.get("when"), e.get("outcome") or "?"
            if when == "setup":
                setup[nid] = outcome
            elif when == "call":
                call[nid] = outcome
            elif when == "teardown":
                teardown[nid] = outcome
    if bad_lines:
        print("haskoki-demo: %d malformed/blank jsonl lines in %s"
              % (bad_lines, path), file=sys.stderr)
        sys.exit(2)
    verdicts = dict(call)
    for nid, outcome in setup.items():
        if nid not in verdicts:
            if outcome == "passed":
                verdicts[nid] = "crashed"
            elif outcome in ("failed", "error", "skipped"):
                verdicts[nid] = outcome
            else:
                verdicts[nid] = "crashed"
    for nid, outcome in teardown.items():
        # Explicit teardown failures surface unless the call record
        # already carries an explicit finding (which wins as primary).
        if outcome in ("failed", "error") and call.get(nid) not in (
                "failed", "error", "crashed", "timeout", "xpassed"):
            verdicts[nid] = outcome
    for nid, outcome in list(verdicts.items()):
        if outcome == "?":
            verdicts[nid] = "crashed"
    return verdicts

d, p = verdicts(djsonl), verdicts(pjsonl)
bad = {"failed", "error", "crashed", "timeout"}
diff, shared = [], []
for nid in sorted(set(d) | set(p)):
    do, po = d.get(nid, "absent"), p.get(nid, "absent")
    if do != po:
        diff.append((do, po, nid))
    elif do in bad:
        shared.append((do, nid))
with open(diffout, "w") as f:
    for do, po, nid in diff:
        f.write("%s %s %s\n" % (do, po, nid))
with open(sharedout, "w") as f:
    for o, nid in shared:
        f.write("%s %s\n" % (o, nid))
print("diffs=%d shared=%d" % (len(diff), len(shared)))
PY
  py_rc=$?
  if [ "$py_rc" -ne 0 ]; then
    echo "haskoki-demo: verdict-map diff failed (see above)" >&2
    return 2
  fi
  diffs=$(wc -l < "$run/diff.txt")
  shared=$(wc -l < "$run/shared-findings.txt")

  finished=$(utc_now)
  tool_versions
  # Exit 1 on findings OR diffs: shared findings are still findings,
  # so zero diffs with shared failures is not healthy.
  exitcode=0
  [ "$diffs" -gt 0 ] && exitcode=1
  [ "$shared" -gt 0 ] && exitcode=1
  # Scalars via argv; diff files read directly (no interpolation).
  python3 - "$run" "$started" "$finished" "$exitcode" "$art" \
    "$CHECKER_VER" "$PY_VER" "$diffs" "$shared" "$VERSION" <<'PY'
import json, sys
(run, started, finished, exitcode, art, checker_ver, pyver,
 diffs, shared, version) = sys.argv[1:11]
diffs_list = []
for line in open(run + "/diff.txt"):
    parts = line.rstrip("\n").split(" ", 2)
    if len(parts) == 3:
        diffs_list.append({"direct": parts[0], "proxy": parts[1],
                           "test": parts[2]})
shared_list = []
for line in open(run + "/shared-findings.txt"):
    line = line.rstrip("\n")
    if line:
        o, _, nid = line.partition(" ")
        shared_list.append({"outcome": o, "test": nid})
report = {
    "command": "compare",
    "subset": "all",
    "subset_status": "provisional (R5 freezes the parity subset)",
    "entrypoint": "haskoki-demo " + version,
    "started_utc": started,
    "finished_utc": finished,
    "exit_code": int(exitcode),
    "run_dir": run,
    "bundle": art,
    "tools": {"checker": checker_ver, "python3": pyver},
    "diff_count": int(diffs),
    "diffs": diffs_list,
    "shared_findings_count": int(shared),
    "shared_findings": shared_list,
}
json.dump(report, open(run + "/report.json", "w"), indent=1)
PY
  py_rc=$?
  if [ "$py_rc" -ne 0 ]; then
    echo "haskoki-demo: cannot write report.json" >&2
    return 2
  fi

  if [ "$outmode" = "json" ]; then
    cat "$run/report.json"
  else
    echo "compare summary (direct/full vs proxy/full) ($run):"
    echo "  shared findings (both modes, not diffs): $shared"
    if [ "$shared" -gt 0 ]; then
      sed 's/^/    shared: /' "$run/shared-findings.txt"
    fi
    if [ "$diffs" -eq 0 ] && [ "$shared" -eq 0 ]; then
      echo "  unexpected diffs: none"
      echo "compare-ok: zero findings and zero unexpected diffs; report: $run/report.json"
    else
      echo "  unexpected diffs ($diffs) [direct proxy test]:"
      [ "$diffs" -gt 0 ] && sed 's/^/    /' "$run/diff.txt"
      echo "compare-FINDINGS: $diffs unexpected diff(s) + $shared shared finding(s); report: $run/report.json"
    fi
  fi
  return "$exitcode"
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

main() {
  outmode="text"
  cmd=""
  mode=""
  profile=""
  help=0
  # Global flags may precede the command; command flags follow it.
  while [ $# -gt 0 ]; do
    case "$1" in
      --output)
        [ $# -ge 2 ] || { echo "haskoki-demo: --output needs json|text" >&2; return 2; }
        outmode="$2"; shift 2
        case "$outmode" in json|text) ;; *) echo "haskoki-demo: --output needs json|text" >&2; return 2 ;; esac
        ;;
      --output=*)
        outmode="${1#--output=}"; shift
        case "$outmode" in json|text) ;; *) echo "haskoki-demo: --output needs json|text" >&2; return 2 ;; esac
        ;;
      --help|-h) help=1; shift ;;
      --mode)
        [ $# -ge 2 ] || { echo "haskoki-demo: --mode needs direct|proxy" >&2; return 2; }
        mode="$2"; shift 2 ;;
      --mode=*) mode="${1#--mode=}"; shift ;;
      --profile)
        [ $# -ge 2 ] || { echo "haskoki-demo: --profile needs smoke|full" >&2; return 2; }
        profile="$2"; shift 2 ;;
      --profile=*) profile="${1#--profile=}"; shift ;;
      demo|check|compare)
        [ -z "$cmd" ] || { echo "haskoki-demo: one command at a time" >&2; return 2; }
        cmd="$1"; shift ;;
      --) shift; break ;;
      -*) echo "haskoki-demo: unknown flag: $1" >&2; top_help >&2; return 2 ;;
      *) echo "haskoki-demo: unknown argument: $1" >&2; top_help >&2; return 2 ;;
    esac
  done
  [ -z "$cmd" ] && cmd="demo"
  # --mode/--profile are meaningless outside check: refuse loudly.
  if [ "$cmd" != "check" ]; then
    if [ -n "$mode" ] || [ -n "$profile" ]; then
      echo "haskoki-demo: $cmd takes no --mode/--profile" >&2
      return 2
    fi
  fi
  # `<cmd> --help` shows that command's help (bare `--help` is caught
  # before dispatch and shows the top help).
  if [ "$help" -eq 1 ]; then
    case "$cmd" in
      demo) demo_help ;;
      check) check_help ;;
      compare) compare_help ;;
    esac
    return 0
  fi
  case "$cmd" in
    demo) cmd_demo "$outmode" ;;
    check) cmd_check "$outmode" "$mode" "$profile" ;;
    compare) cmd_compare "$outmode" ;;
  esac
}

# Bare `--help` (no command word) prints the top help; `<cmd> --help`
# prints that command's help. Detect the bare form before dispatch.
bare_help=0
saw_cmd=0
for a in "$@"; do
  case "$a" in
    demo|check|compare) saw_cmd=1 ;;
    --help|-h) bare_help=1 ;;
  esac
done
if [ "$bare_help" -eq 1 ] && [ "$saw_cmd" -eq 0 ]; then
  top_help
  exit 0
fi

main "$@"
exit $?
