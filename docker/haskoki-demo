unexpected diffs / 2 usage or infrastructure failure.
EOF
}

# ---------------------------------------------------------------------------
# Small utilities
# ---------------------------------------------------------------------------

# Resolve the single bundle tree (fail loudly unless exactly one).
bundle_dir() {
  n=$(ls -d "$BUNDLE_ROOT"/haskoki-* 2>/dev/null | wc -l)
  if [ "$n" -ne 1 ]; then
    echo "haskoki-demo: want exactly one bundle under $BUNDLE_ROOT, found $n" >&2
    return 1
  fi
  echo "$BUNDLE_ROOT"/haskoki-*
}

utc_now() {
  date -u +%Y%m%dT%H%M%SZ
}

# Make a unique run dir under /out (fail loudly when /out is missing
# or not writable — exit 2 at the caller).
make_run_dir() {
  # $1 = command tag
  out="${HASKOKI_DEMO_OUT:-$OUT_DEFAULT}"
  if [ ! -d "$out" ]; then
    echo "haskoki-demo: output dir missing: $out (bind it with -v OUT:/out)" >&2
    return 1
  fi
  if [ ! -w "$out" ]; then
    echo "haskoki-demo: output dir not writable: $out" >&2
    return 1
  fi
  # mktemp is atomic (no concurrent-invocation collision) but yields
  # mode 0700; the host user collects results from the bind mount, so
  # open the dir (run dirs never carry secrets — PINs are never logged).
  run=$(mktemp -d "$out/$1-$(utc_now)-$$-XXXXXX") || return 1
  chmod 755 "$run" || return 1
  echo "$run"
}

# Redact --pin/--so-pin values for log echoes (fixtures are public,
# but values still never hit logs).
redact() {
  # stdin -> stdout with pin values replaced
  sed -e 's/--pin [^ ]*/--pin [withheld]/g' \
      -e 's/--so-pin [^ ]*/--so-pin [withheld]/g'
}

tool_versions() {
  # prints shell assignments: P11TOOL_INFO OPENSC_VER CHECKER_VER PY_VER
  P11TOOL_INFO="unknown"
  OPENSC_VER="unknown"
  CHECKER_VER="unknown"
  PY_VER="unknown"
  if command -v pkcs11-tool >/dev/null 2>&1; then
    P11TOOL_INFO="present"
  fi
  if command -v dpkg-query >/dev/null 2>&1; then
    OPENSC_VER=$(dpkg-query -W -f='${Version}' opensc 2>/dev/null || echo unknown)
  fi
  if [ -x "$CHECKER" ]; then
    CHECKER_VER=$("$CHECKER" version 2>/dev/null | head -1 || echo unknown)
  fi
  if command -v python3 >/dev/null 2>&1; then
    PY_VER=$(python3 --version 2>&1 || echo unknown)
  fi
}

# Progress chatter: stdout in text mode, stderr in json mode (where
# stdout carries exactly one JSON document). Errors always use stderr.
OUTMODE="text"
say() {
  if [ "$OUTMODE" = "json" ]; then
    echo "$*" >&2
  else
    echo "$*"
  fi
}

# TCP connect probe (python3): exit 0 when something accepts.
tcp_accepts() {
  # $1 = port
  python3 -c "
import socket, sys
s = socket.socket()
s.settimeout(2)
try:
    s.connect(('127.0.0.1', $1))
except OSError:
    sys.exit(1)
sys.exit(0)
"
}

# ---------------------------------------------------------------------------
# demo
# ---------------------------------------------------------------------------

cmd_demo() {
  # $1 = output mode (text|json)
  outmode="$1"; OUTMODE="$1"
  started=$(utc_now)
  art=$(bundle_dir) || return 2
  SO="$art/lib/libhaskoki.so"
  [ -f "$SO" ] || { echo "haskoki-demo: module missing: $SO" >&2; return 2; }
  command -v pkcs11-tool >/dev/null 2>&1 \
    || { echo "haskoki-demo: pkcs11-tool missing" >&2; return 2; }
  run=$(make_run_dir demo) || return 2

  # Fixed PUBLIC fixtures (pinned bytes; determinism documented below).
  printf 'abc' > "$run/msg-sign.bin"
  printf 'hello-rsa' > "$run/msg-enc.bin"
  USER_PIN="1234"
  SO_PIN="5678"
  EC_LABEL="demo-ec"
  RSA_LABEL="demo-rsa"
  # Pinned FIPS 180-4 SHA-256("abc") constant (deterministic anchor).
  SHA_ABC="ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"

  # Isolated single-purpose stores (see demo --help for why).
  cat > "$run/backend-sign.toml" <<EOF
schema_version = 1
profile = "real-crypto"
[storage]
kind = "sqlite"
path = "$run/sign.sqlite"
[engine]
kind = "openssl"
allow_synthetic_fallback = false
private_library_context = true
[trace]
enabled = false
EOF
  sed "s#sign.sqlite#enc.sqlite#" "$run/backend-sign.toml" > "$run/backend-enc.toml"

  fails=0
  step() {
    # $1 = step tag, rest = description (echoed redacted)
    tag="$1"; shift
    say "$(echo "demo [$tag]: $*" | redact)"
  }
  note() {
    # append "rc=<rc> <text>" to the step ledger
    echo "$1" >> "$run/steps.log"
  }
  : > "$run/steps.log"

  # 1. slot listing (token present).
  step slots "pkcs11-tool --module ... -L"
  HASKOKI_CONFIG="$run/backend-sign.toml" pkcs11-tool --module "$SO" -L \
    > "$run/step-slots.out" 2> "$run/step-slots.err"
  rc=$?
  if [ $rc -eq 0 ] && grep -q 'token label *: haskoki-demo' "$run/step-slots.out"; then
    note "rc=0 slots token haskoki-demo present"
  else
    note "rc=$rc slots FAILED (see step-slots.out/err)"; fails=$((fails + 1))
  fi

  # 2. EC keypairgen.
  step ec-keygen "pkcs11-tool --keypairgen EC:prime256v1 --label $EC_LABEL"
  HASKOKI_CONFIG="$run/backend-sign.toml" pkcs11-tool --module "$SO" \
    --keypairgen --key-type EC:prime256v1 --label "$EC_LABEL" --usage-sign \
    -l --pin "$USER_PIN" > "$run/step-ec-keygen.out" 2> "$run/step-ec-keygen.err"
  rc=$?
  if [ $rc -eq 0 ]; then note "rc=0 ec-keygen ok"; else
    note "rc=$rc ec-keygen FAILED"; fails=$((fails + 1)); fi

  # 3. ECDSA-SHA256 sign (raw R||S must be exactly 64 bytes).
  step ec-sign "pkcs11-tool -s -m ECDSA-SHA256"
  HASKOKI_CONFIG="$run/backend-sign.toml" pkcs11-tool --module "$SO" \
    -s -m ECDSA-SHA256 --label "$EC_LABEL" --type privkey \
    -l --pin "$USER_PIN" -i "$run/msg-sign.bin" -o "$run/sig.bin" \
    > "$run/step-ec-sign.out" 2> "$run/step-ec-sign.err"
  rc=$?
  sigbytes=0
  [ -f "$run/sig.bin" ] && sigbytes=$(wc -c < "$run/sig.bin" | tr -d ' ')
  if [ $rc -eq 0 ] && [ "$sigbytes" -eq 64 ]; then
    note "rc=0 ec-sign ok sig_bytes=64"
  else
    note "rc=$rc ec-sign FAILED sig_bytes=$sigbytes"; fails=$((fails + 1)); fi

  # 4. ECDSA verify ("Signature is valid").
  step ec-verify "pkcs11-tool --verify -m ECDSA-SHA256"
  HASKOKI_CONFIG="$run/backend-sign.toml" pkcs11-tool --module "$SO" \
    --verify -m ECDSA-SHA256 --label "$EC_LABEL" --type pubkey \
    -l --pin "$USER_PIN" -i "$run/msg-sign.bin" \
    --signature-file "$run/sig.bin" \
    > "$run/step-ec-verify.out" 2> "$run/step-ec-verify.err"
  rc=$?
  # Verdict stream varies by opensc release: accept stdout or stderr.
  if [ $rc -eq 0 ] && grep -q 'Signature is valid' \
      "$run/step-ec-verify.out" "$run/step-ec-verify.err" 2>/dev/null; then
    note "rc=0 ec-verify ok (Signature is valid)"
  else
    note "rc=$rc ec-verify FAILED"; fails=$((fails + 1)); fi

  # 5. SHA-256 digest anchor (module bytes vs pinned constant + sha256sum).
  step digest "pkcs11-tool -h -m SHA256 (pinned-constant comparison)"
  HASKOKI_CONFIG="$run/backend-sign.toml" pkcs11-tool --module "$SO" \
    -h -m SHA256 -i "$run/msg-sign.bin" \
    > "$run/digest.raw" 2> "$run/step-digest.err"
  rc=$?
  gothex=""
  [ -f "$run/digest.raw" ] && gothex=$(od -A n -t x1 "$run/digest.raw" | tr -d ' \n')
  wanthex="$SHA_ABC"
  syshex=$(sha256sum "$run/msg-sign.bin" | awk '{print $1}')
  if [ $rc -eq 0 ] && [ "$gothex" = "$wanthex" ] && [ "$syshex" = "$wanthex" ]; then
    note "rc=0 digest ok sha256(abc)=$gothex"
  else
    note "rc=$rc digest FAILED module=$gothex pinned=$wanthex sys=$syshex"
    fails=$((fails + 1)); fi

  # 6. RSA keypairgen.
  step rsa-keygen "pkcs11-tool --keypairgen RSA:2048 --label $RSA_LABEL"
  HASKOKI_CONFIG="$run/backend-enc.toml" pkcs11-tool --module "$SO" \
    --keypairgen --key-type RSA:2048 --label "$RSA_LABEL" --usage-decrypt \
    -l --pin "$USER_PIN" > "$run/step-rsa-keygen.out" 2> "$run/step-rsa-keygen.err"
  rc=$?
  if [ $rc -eq 0 ]; then note "rc=0 rsa-keygen ok"; else
    note "rc=$rc rsa-keygen FAILED"; fails=$((fails + 1)); fi

  # 7. RSA-OAEP-SHA256 encrypt (2048-bit output = 256 bytes).
  step rsa-encrypt "pkcs11-tool --encrypt -m RSA-PKCS-OAEP --hash-algorithm SHA256"
  HASKOKI_CONFIG="$run/backend-enc.toml" pkcs11-tool --module "$SO" \
    --encrypt -m RSA-PKCS-OAEP --hash-algorithm SHA256 \
    -l --pin "$USER_PIN" -i "$run/msg-enc.bin" -o "$run/enc.bin" \
    > "$run/step-rsa-encrypt.out" 2> "$run/step-rsa-encrypt.err"
  rc=$?
  encbytes=0
  [ -f "$run/enc.bin" ] && encbytes=$(wc -c < "$run/enc.bin" | tr -d ' ')
  if [ $rc -eq 0 ] && [ "$encbytes" -eq 256 ]; then
    note "rc=0 rsa-encrypt ok ct_bytes=256"
  else
    note "rc=$rc rsa-encrypt FAILED ct_bytes=$encbytes"; fails=$((fails + 1)); fi

  # 8. RSA-OAEP-SHA256 decrypt + byte-identical round-trip.
  step rsa-decrypt "pkcs11-tool --decrypt -m RSA-PKCS-OAEP + cmp round-trip"
  HASKOKI_CONFIG="$run/backend-enc.toml" pkcs11-tool --module "$SO" \
    --decrypt -m RSA-PKCS-OAEP --hash-algorithm SHA256 \
    -l --pin "$USER_PIN" -i "$run/enc.bin" -o "$run/dec.bin" \
    > "$run/step-rsa-decrypt.out" 2> "$run/step-rsa-decrypt.err"
  rc=$?
  if [ $rc -eq 0 ] && cmp -s "$run/msg-enc.bin" "$run/dec.bin"; then
    note "rc=0 rsa-decrypt ok round-trip identical"
  else
    note "rc=$rc rsa-decrypt FAILED"; fails=$((fails + 1)); fi

  finished=$(utc_now)
  tool_versions
  modsha=$(sha256sum "$SO" | awk '{print $1}')
  msgsha=$(sha256sum "$run/msg-sign.bin" | awk '{print $1}')
  encmsgsha=$(sha256sum "$run/msg-enc.bin" | awk '{print $1}')
  exitcode=0
  [ "$fails" -gt 0 ] && exitcode=1

  # JSON report (machine-readable; PIN values never included).
  # Scalars via argv; steps read from the ledger (no interpolation).
  python3 - "$run" "$started" "$finished" "$exitcode" "$art" "$modsha" \
    "$P11TOOL_INFO" "$OPENSC_VER" "$PY_VER" "$msgsha" "$encmsgsha" \
    "$EC_LABEL" "$RSA_LABEL" "$SHA_ABC" "$VERSION" <<'PY'
import json, sys
(run, started, finished, exitcode, art, modsha, p11info, ossl, pyver,
 msgsha, encmsgsha, eclabel, rsalabel, anchor, version) = sys.argv[1:16]
steps = []
for line in open(run + "/steps.log"):
    line = line.rstrip("\n")
    if line:
        rc, _, rest = line.partition(" ")
        steps.append({"rc": rc, "detail": rest})
report = {
    "command": "demo",
    "entrypoint": "haskoki-demo " + version,
    "started_utc": started,
    "finished_utc": finished,
    "exit_code": int(exitcode),
    "run_dir": run,
    "bundle": art,
    "module_sha256": modsha,
    "tools": {"pkcs11_tool": p11info, "opensc": ossl, "python3": pyver},
    "fixtures": {
        "note": "all PUBLIC pinned fixtures (no real secrets)",
        "msg_sign": {"file": "msg-sign.bin", "sha256": msgsha},
        "msg_enc": {"file": "msg-enc.bin", "sha256": encmsgsha},
        "pins": "PUBLIC-FIXED (values withheld from logs)",
        "labels": [eclabel, rsalabel],
        "oaep": "SHA256 + MGF1-SHA256",
        "digest_anchor": anchor,
    },
    "determinism": "exit codes, output shapes, digest bytes and round-trip equality are fixed; fresh key bytes, signatures and ciphertexts vary per run by design",
    "steps": steps,
}
json.dump(report, open(run + "/report.json", "w"), indent=1)
PY
  py_rc=$?
  if [ "$py_rc" -ne 0 ]; then
    echo "haskoki-demo: cannot write report.json" >&2
    return 2
  fi

  if [ "$outmode" = "json" ]; then
    cat "$run/report.json"
  else
    echo "demo summary ($run):"
    sed 's/^/  /' "$run/steps.log"
    if [ "$fails" -eq 0 ]; then
      echo "demo-ok: 8/8 verifications hold; report: $run/report.json"
    else
      echo "demo-FINDINGS: $fails verification(s) failed; report: $run/report.json"
    fi
  fi
  return "$exitcode"
}

