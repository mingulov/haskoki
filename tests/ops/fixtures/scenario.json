{
  "schema_version": 1,
  "name": "pending-sign-and-token-removal",
  "note": {
    "status": "design-example-not-executed",
    "notice": "The owned-instance runner interprets these actions; a separate CLI does not control another loaded process.",
    "assumes": "fresh owned store"
  },
  "rules": [],
  "steps": [
    {
      "action": "initialize"
    },
    {
      "action": "fixture.load",
      "arguments": {
        "fixture": "minimal-demo"
      }
    },
    {
      "action": "session.open",
      "arguments": {
        "token": "haskoki-demo",
        "read_write": true,
        "asynchronous": true
      },
      "save_as": "s1"
    },
    {
      "action": "session.login",
      "arguments": {
        "session": "s1",
        "role": "USER",
        "pin": "1234"
      }
    },
    {
      "action": "sign.init",
      "arguments": {
        "session": "s1",
        "fixture_key": "demo-signing-key",
        "mechanism": "CKM_RSA_PKCS"
      }
    },
    {
      "action": "sign",
      "arguments": {
        "session": "s1",
        "data_base64": "ZGVtbyBtZXNzYWdl",
        "output_capacity": 256
      },
      "expect": {
        "return": "CKR_PENDING"
      }
    },
    {
      "action": "async.complete",
      "arguments": {
        "session": "s1",
        "function": "C_Sign"
      },
      "expect": {
        "return": "CKR_PENDING"
      }
    },
    {
      "action": "async.complete",
      "arguments": {
        "session": "s1",
        "function": "C_Sign"
      },
      "expect": {
        "return": "CKR_PENDING"
      }
    },
    {
      "action": "async.complete",
      "arguments": {
        "session": "s1",
        "function": "C_Sign"
      },
      "expect": {
        "return": "CKR_OK"
      }
    },
    {
      "action": "token.remove",
      "arguments": {
        "token": "haskoki-demo"
      }
    },
    {
      "action": "slot-event.wait",
      "arguments": {
        "nonblocking": true
      },
      "expect": {
        "event": "token-state-change"
      }
    },
    {
      "action": "finalize"
    }
  ]
}
