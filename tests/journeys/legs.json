{
  "$schema": "haskoki-journey-legs/1",
  "clients": {
    "opensc": {
      "package": "opensc",
      "package_version": "0.27.0~rc1-1",
      "runtime_argv": ["dpkg-query", "-W", "-f=${Version}", "opensc"],
      "runtime_version": "0.27.0~rc1-1"
    },
    "gnutls": {
      "package": "gnutls-bin",
      "package_version": "3.8.12-2ubuntu1.1",
      "runtime_argv": ["p11tool", "--version"],
      "runtime_version": "p11tool 3.8.12"
    },
    "java": {
      "package": "default-jdk-headless",
      "package_version": "2:1.25-77",
      "runtime_argv": ["java", "-version"],
      "runtime_version": "25.0.4.1",
      "compile_target": "17"
    },
    "openssl": {
      "package": "openssl",
      "package_version": "3.5.5-1ubuntu3.7",
      "runtime_argv": ["openssl", "version"],
      "runtime_version": "OpenSSL 3.5.5"
    },
    "native": {
      "package": null,
      "package_version": null,
      "runtime_argv": null,
      "runtime_version": null
    },
    "runner": {
      "package": null,
      "package_version": null,
      "runtime_argv": null,
      "runtime_version": null
    }
  },
  "profiles": {
    "portfolio": {
      "description": "Installed bundle plus pinned clients in a disposable client container.",
      "clients": ["opensc", "gnutls", "java", "openssl", "native", "runner"],
      "phases": ["module", "verifier"]
    },
    "image": {
      "description": "Candidate demo image: module phase in the image, verifier phase on the host.",
      "clients": ["opensc", "native", "runner"],
      "phases": ["module", "verifier"]
    }
  },
  "probes": {
    "java-token-probe": {
      "path": "tests/journeys/java/JavaTokenProbe.java",
      "sha256": "c1c77e8459f1c45de3fae2dcf8279848f206a60fc8379e50480d57d7ec243eb6",
      "origin_commit": "a96a753c9e80353eed29eacca9bb9bafc0cfecb5",
      "origin_path": "tests/review/JavaTokenProbe.java",
      "introduced_by": "8fcb405",
      "compile": ["javac", "--release", "17", "-d", "@RUN@/java", "@SRC@/tests/journeys/java/JavaTokenProbe.java"],
      "run": ["java", "--add-modules", "jdk.crypto.cryptoki,jdk.crypto.ec", "-cp", "@RUN@/java", "JavaTokenProbe", "@RUN@/cfg/sunpkcs11.cfg"]
    }
  },
  "legs": [
    {
      "name": "opensc-connect",
      "profiles": ["portfolio", "image"],
      "phase": "module",
      "client": "opensc",
      "store": "opensc",
      "argv": ["pkcs11-tool", "--module", "@MODULE@", "--list-slots"],
      "timeout_seconds": 120,
      "expect": {"exit": 0, "markers": ["haskoki-demo"]},
      "depends_on": []
    },
    {
      "name": "opensc-enumerate",
      "profiles": ["portfolio", "image"],
      "phase": "module",
      "client": "opensc",
      "store": "opensc",
      "argv": ["pkcs11-tool", "--module", "@MODULE@", "--login", "--pin", "1234", "--list-objects"],
      "timeout_seconds": 120,
      "expect": {"exit": 0},
      "depends_on": ["opensc-connect"]
    },
    {
      "name": "opensc-create-ec",
      "profiles": ["portfolio", "image"],
      "phase": "module",
      "client": "opensc",
      "store": "opensc",
      "argv": ["pkcs11-tool", "--module", "@MODULE@", "--login", "--pin", "1234", "--keypairgen", "--key-type", "EC:prime256v1", "--label", "review-ec", "--id", "0101", "--usage-sign"],
      "timeout_seconds": 120,
      "expect": {"exit": 0, "markers": ["Key pair generated", "ID:         0101"]},
      "depends_on": ["opensc-enumerate"]
    },
    {
      "name": "opensc-export-pubkey",
      "profiles": ["portfolio", "image"],
      "phase": "module",
      "client": "opensc",
      "store": "opensc",
      "argv": ["pkcs11-tool", "--module", "@MODULE@", "--read-object", "--type", "pubkey", "--id", "0101", "-o", "@RUN@/out/ec-pub.der"],
      "timeout_seconds": 120,
      "expect": {"exit": 0, "files": [{"path": "out/ec-pub.der", "op": "nonempty"}]},
      "depends_on": ["opensc-create-ec"]
    },
    {
      "name": "opensc-sign",
      "profiles": ["portfolio", "image"],
      "phase": "module",
      "client": "opensc",
      "store": "opensc",
      "argv": ["pkcs11-tool", "--module", "@MODULE@", "--login", "--pin", "1234", "--sign", "--mechanism", "ECDSA-SHA256", "--id", "0101", "--signature-format", "openssl", "--input-file", "@SRC@/tests/journeys/opensc/message.txt", "--output-file", "@RUN@/out/ec-sig.der"],
      "timeout_seconds": 120,
      "expect": {"exit": 0},
      "requires_verification": "opensc-verify-independent",
      "depends_on": ["opensc-create-ec"]
    },
    {
      "name": "opensc-verify-independent",
      "profiles": ["portfolio", "image"],
      "phase": "verifier",
      "client": "openssl",
      "argv": ["openssl", "dgst", "-sha256", "-verify", "@RUN@/out/ec-pub.der", "-keyform", "DER", "-signature", "@RUN@/out/ec-sig.der", "@SRC@/tests/journeys/opensc/message.txt"],
      "timeout_seconds": 120,
      "expect": {"exit": 0, "markers": ["Verified OK"]},
      "depends_on": ["opensc-export-pubkey", "opensc-sign"]
    },
    {
      "name": "opensc-tamper-independent",
      "profiles": ["portfolio", "image"],
      "phase": "verifier",
      "client": "openssl",
      "argv": ["openssl", "dgst", "-sha256", "-verify", "@RUN@/out/ec-pub.der", "-keyform", "DER", "-signature", "@RUN@/out/ec-sig.der", "@SRC@/tests/journeys/opensc/message-changed.txt"],
      "timeout_seconds": 120,
      "expect": {"exit": 1, "markers": ["Verification failure"]},
      "depends_on": ["opensc-export-pubkey", "opensc-sign"]
    },
    {
      "name": "opensc-verify",
      "profiles": ["portfolio", "image"],
      "phase": "module",
      "client": "opensc",
      "store": "opensc",
      "argv": ["pkcs11-tool", "--module", "@MODULE@", "--verify", "--mechanism", "ECDSA-SHA256", "--id", "0101", "--signature-format", "openssl", "--input-file", "@SRC@/tests/journeys/opensc/message.txt", "--signature-file", "@RUN@/out/ec-sig.der"],
      "timeout_seconds": 120,
      "expect": {"exit": 0, "markers": ["Signature is valid"]},
      "depends_on": ["opensc-sign"]
    },
    {
      "name": "opensc-tamper",
      "profiles": ["portfolio", "image"],
      "phase": "module",
      "client": "opensc",
      "store": "opensc",
      "argv": ["pkcs11-tool", "--module", "@MODULE@", "--verify", "--mechanism", "ECDSA-SHA256", "--id", "0101", "--signature-format", "openssl", "--input-file", "@SRC@/tests/journeys/opensc/message-changed.txt", "--signature-file", "@RUN@/out/ec-sig.der"],
      "timeout_seconds": 120,
      "expect": {"exit": 1, "markers": ["Invalid signature"]},
      "depends_on": ["opensc-sign"]
    },
    {
      "name": "opensc-create-rsa",
      "profiles": ["portfolio", "image"],
      "phase": "module",
      "client": "opensc",
      "store": "opensc",
      "argv": ["pkcs11-tool", "--module", "@MODULE@", "--login", "--pin", "1234", "--keypairgen", "--key-type", "rsa:2048", "--label", "review-rsa", "--id", "0102", "--usage-decrypt"],
      "timeout_seconds": 300,
      "expect": {"exit": 0},
      "depends_on": ["opensc-enumerate"]
    },
    {
      "name": "opensc-encrypt",
      "profiles": ["portfolio", "image"],
      "phase": "module",
      "client": "opensc",
      "store": "opensc",
      "argv": ["pkcs11-tool", "--module", "@MODULE@", "--encrypt", "--mechanism", "RSA-PKCS", "--id", "0102", "--input-file", "@SRC@/tests/journeys/opensc/message.txt", "--output-file", "@RUN@/out/rsa.bin"],
      "timeout_seconds": 120,
      "expect": {"exit": 0},
      "depends_on": ["opensc-create-rsa"]
    },
    {
      "name": "opensc-decrypt",
      "profiles": ["portfolio", "image"],
      "phase": "module",
      "client": "opensc",
      "store": "opensc",
      "argv": ["python3", "@SRC@/tests/journeys/journeys.py", "decrypt-staged", "--run", "@RUN@", "--plaintext-src", "@SRC@/tests/journeys/opensc/message.txt", "--plaintext-run", "out/message.txt", "--", "pkcs11-tool", "--module", "@MODULE@", "--login", "--pin", "1234", "--decrypt", "--mechanism", "RSA-PKCS", "--id", "0102", "--input-file", "@RUN@/out/rsa.bin", "--output-file", "@RUN@/out/rsa.dec"],
      "timeout_seconds": 120,
      "expect": {"exit": 0, "markers": ["JOURNEY-DECRYPT staged"], "files": [{"path": "out/rsa.dec", "op": "equal", "other": "out/message.txt"}]},
      "depends_on": ["opensc-encrypt"]
    },
    {
      "name": "opensc-refuse-wrong-pin",
      "profiles": ["portfolio", "image"],
      "phase": "module",
      "client": "opensc",
      "store": "opensc",
      "argv": ["pkcs11-tool", "--module", "@MODULE@", "--login", "--pin", "0000", "--list-objects"],
      "timeout_seconds": 120,
      "expect": {"exit": 1},
      "expect_refusal": {"rv": "CKR_PIN_INCORRECT"},
      "depends_on": []
    },
    {
      "name": "opensc-enumerate-after-refusal",
      "profiles": ["portfolio", "image"],
      "phase": "module",
      "client": "opensc",
      "store": "opensc",
      "argv": ["pkcs11-tool", "--module", "@MODULE@", "--login", "--pin", "1234", "--list-objects"],
      "timeout_seconds": 120,
      "expect": {"exit": 0},
      "depends_on": ["opensc-refuse-wrong-pin"]
    },
    {
      "name": "opensc-refuse-init-token-store-owned",
      "profiles": ["portfolio", "image"],
      "phase": "module",
      "client": "opensc",
      "store": "opensc",
      "argv": ["python3", "@SRC@/tests/journeys/journeys.py", "store-owned-refusal", "--module", "@MODULE@", "--native", "@NATIVE@", "--run", "@RUN@", "--", "pkcs11-tool", "--module", "@MODULE@", "--init-token", "--label", "haskoki-demo", "--so-pin", "5678"],
      "timeout_seconds": 120,
      "expect": {"exit": 0, "markers": ["FIXTURE hold released", "JOURNEY-STORE-OWNED-REFUSED"]},
      "expect_refusal": {"rv": "CKR_GENERAL_ERROR", "markers": ["C_Initialize failed"]},
      "unchanged": "stores/opensc/shared-tokens.db",
      "depends_on": ["opensc-enumerate-after-refusal"]
    },
    {
      "name": "opensc-connect-after-owner",
      "profiles": ["portfolio", "image"],
      "phase": "module",
      "client": "opensc",
      "store": "opensc",
      "argv": ["pkcs11-tool", "--module", "@MODULE@", "--list-slots"],
      "timeout_seconds": 120,
      "expect": {"exit": 0},
      "depends_on": ["opensc-refuse-init-token-store-owned"]
    },
    {
      "name": "native-init-token-session-exists",
      "profiles": ["portfolio", "image"],
      "phase": "module",
      "client": "native",
      "store": "native",
      "argv": ["@NATIVE@/token_fixture", "@MODULE@", "init-busy"],
      "timeout_seconds": 120,
      "expect": {"exit": 0, "markers": ["FIXTURE init-busy unchanged"]},
      "expect_refusal": {"rv": "CKR_SESSION_EXISTS"},
      "depends_on": []
    },
    {
      "name": "native-aead",
      "profiles": ["portfolio", "image"],
      "phase": "module",
      "client": "native",
      "store": "native",
      "argv": ["@NATIVE@/consumer_aead", "@MODULE@"],
      "cwd": "@SRC@",
      "timeout_seconds": 300,
      "expect": {"exit": 0, "markers": ["PASS: consumer_aead"]},
      "depends_on": []
    },
    {
      "name": "native-certlink-metadata",
      "profiles": ["portfolio", "image"],
      "phase": "module",
      "client": "native",
      "store": "native",
      "argv": ["@NATIVE@/consumer_certlink", "@MODULE@"],
      "cwd": "@SRC@",
      "timeout_seconds": 300,
      "expect": {"exit": 0, "markers": ["PASS: consumer_certlink", "linked private key reports the curve parameters"]},
      "depends_on": []
    },
    {
      "name": "opensc-provision-init-token",
      "profiles": ["portfolio", "image"],
      "phase": "module",
      "client": "opensc",
      "store": "provision",
      "argv": ["pkcs11-tool", "--module", "@MODULE@", "--init-token", "--label", "haskoki-demo", "--so-pin", "5678"],
      "timeout_seconds": 60,
      "expect": {"exit": 0, "markers": ["Token successfully initialized"]},
      "depends_on": []
    },
    {
      "name": "opensc-provision-init-pin",
      "profiles": ["portfolio", "image"],
      "phase": "module",
      "client": "opensc",
      "store": "provision",
      "argv": ["pkcs11-tool", "--module", "@MODULE@", "--login", "--login-type", "so", "--so-pin", "5678", "--init-pin", "--pin", "pin-bravo-02"],
      "timeout_seconds": 60,
      "expect": {"exit": 0, "markers": ["User PIN successfully initialized"]},
      "depends_on": ["opensc-provision-init-token"]
    },
    {
      "name": "opensc-provision-change-pin",
      "profiles": ["portfolio", "image"],
      "phase": "module",
      "client": "opensc",
      "store": "provision",
      "argv": ["pkcs11-tool", "--module", "@MODULE@", "--login", "--pin", "pin-bravo-02", "--change-pin", "--new-pin", "pin-charlie-03"],
      "timeout_seconds": 60,
      "expect": {"exit": 0, "markers": ["PIN successfully changed"]},
      "depends_on": ["opensc-provision-init-pin"]
    },
    {
      "name": "opensc-provision-create-ec",
      "profiles": ["portfolio", "image"],
      "phase": "module",
      "client": "opensc",
      "store": "provision",
      "argv": ["pkcs11-tool", "--module", "@MODULE@", "--login", "--pin", "pin-charlie-03", "--keypairgen", "--key-type", "EC:prime256v1", "--label", "prov-ec", "--id", "0909", "--usage-sign"],
      "timeout_seconds": 60,
      "expect": {"exit": 0, "markers": ["Key pair generated"]},
      "depends_on": ["opensc-provision-change-pin"]
    },
    {
      "name": "opensc-provision-export-pubkey",
      "profiles": ["portfolio", "image"],
      "phase": "module",
      "client": "opensc",
      "store": "provision",
      "argv": ["pkcs11-tool", "--module", "@MODULE@", "--read-object", "--type", "pubkey", "--id", "0909", "-o", "@RUN@/out/prov-pub.der"],
      "timeout_seconds": 60,
      "expect": {"exit": 0, "markers": [], "files": [{"path": "out/prov-pub.der", "op": "nonempty"}]},
      "depends_on": ["opensc-provision-create-ec"]
    },
    {
      "name": "opensc-provision-sign",
      "profiles": ["portfolio", "image"],
      "phase": "module",
      "client": "opensc",
      "store": "provision",
      "argv": ["pkcs11-tool", "--module", "@MODULE@", "--login", "--pin", "pin-charlie-03", "--sign", "--mechanism", "ECDSA-SHA256", "--id", "0909", "--signature-format", "openssl", "--input-file", "@SRC@/tests/journeys/provision/provision-message.txt", "--output-file", "@RUN@/out/prov-sig.der"],
      "timeout_seconds": 60,
      "expect": {"exit": 0, "markers": []},
      "requires_verification": "opensc-provision-verify-independent",
      "depends_on": ["opensc-provision-export-pubkey"]
    },
    {
      "name": "opensc-provision-verify-independent",
      "profiles": ["portfolio", "image"],
      "phase": "verifier",
      "client": "openssl",
      "argv": ["openssl", "dgst", "-sha256", "-verify", "@RUN@/out/prov-pub.der", "-keyform", "DER", "-signature", "@RUN@/out/prov-sig.der", "@SRC@/tests/journeys/provision/provision-message.txt"],
      "timeout_seconds": 60,
      "expect": {"exit": 0, "markers": ["Verified OK"]},
      "depends_on": ["opensc-provision-export-pubkey", "opensc-provision-sign"]
    },
    {
      "name": "opensc-provision-enumerate-new-pin",
      "profiles": ["portfolio", "image"],
      "phase": "module",
      "client": "opensc",
      "store": "provision",
      "argv": ["pkcs11-tool", "--module", "@MODULE@", "--login", "--pin", "pin-charlie-03", "--list-objects"],
      "timeout_seconds": 60,
      "expect": {"exit": 0, "markers": ["prov-ec"]},
      "depends_on": ["opensc-provision-create-ec"]
    },
    {
      "name": "opensc-provision-refuse-old-pin",
      "profiles": ["portfolio", "image"],
      "phase": "module",
      "client": "opensc",
      "store": "provision",
      "argv": ["pkcs11-tool", "--module", "@MODULE@", "--login", "--pin", "pin-bravo-02", "--list-objects"],
      "timeout_seconds": 60,
      "expect": {"exit": 1, "markers": []},
      "expect_refusal": {"rv": "CKR_PIN_INCORRECT", "markers": ["CKR_PIN_INCORRECT"]},
      "depends_on": ["opensc-provision-enumerate-new-pin"]
    }
  ]
}
