    base            >= 4.14 && < 5,
    bytestring      >= 0.10 && < 0.13,
    containers      >= 0.6  && < 0.9,
    directory       >= 1.3  && < 1.4,
    filepath        >= 1.4  && < 1.6,
    haskoki:haskoki-internal,
    haskoki:haskoki-core,
    process         >= 1.6  && < 1.7,
    QuickCheck      >= 2.14 && < 2.20,
    tasty           >= 1.4  && < 1.6,
