cabal-version:      3.12
name:               haskoki
version:            0.6.2.0
synopsis:           Haskell PKCS#11 soft token (demonstrator)
description:
  A Haskell soft token that makes the PKCS#11 surface (APIs 2.40, 3.0, 3.1
  and 3.2) easy to exercise and understand. At 0.6.2.0: a C-loadable
  shared module with byte-pinned versioned tables, exact per-function
  error codes, config-gated test seams (env seams inert by
  default), and USDT crypto-auditing observability, proven
  in-process through real libcrypto, native consumer
  and proxy-parity proofs, and a relocatable release artifact. The C
  tables route real crypto (sessions, objects, sign/verify,
  encrypt/decrypt, digest, wrap/unwrap, derive); genuinely
  unsupported calls refuse honestly. Not a conformance claim.
license:            Apache-2.0
license-file:       LICENSE
author:             haskoki contributors
maintainer:         haskoki contributors
category:           Security, Cryptography
build-type:         Simple
-- Supported compiler: GHC 9.10.3 (OS package or ghcup vanilla;
-- see docs/toolchain.md).
tested-with:       GHC == 9.10.3
extra-doc-files:
  README.md
  CHANGELOG.md
  SUPPORTED-HOSTS.md
  docs/*.md
  docs/*.json
  docs/release-results/*.json
-- Source-package completeness: c-sources/.hs modules ship
-- automatically; everything else the build or the test suites read
-- (headers, generated .inc, spec inputs, fixtures, the catalog doc
-- one suite reads, the frozen build plan) is listed here so
-- `cabal sdist` unpacks to a buildable + testable tree. Verified by
-- unpacking the sdist outside the checkout and running the
-- docs/toolchain.md source-build recipe.
extra-source-files:
  cbits/*.h
  cbits/*.inc
  spec/*.json
  spec/*.txt
  spec/*.sql
  spec/vendor/*.h
  spec/planning/*.md
  spec/planning/*.csv
  tests/fixtures/*.der
  tests/fixtures/*.txt
  tests/engine/golden/*.txt
  tests/fixtures/stores/*.in
  tests/fixtures/stores/**/store.sqlite
  tests/fixtures/stores/**/manifest.txt
  scripts/make-store-fixtures.sh
  tests/ops/fixtures/*.toml
  tests/ops/fixtures/*.json
  tests/ops/fixtures/*.md
  docs/config-honesty.md
  cabal.project.freeze
  tests/journeys/*.json
  tests/journeys/*.py
  tests/journeys/gnutls/*.toml
  tests/journeys/gnutls/*.urls
  tests/journeys/java/*.java
  tests/journeys/keystore/*.toml
  tests/journeys/keystore/*.cfg
  tests/journeys/keystore/*.txt
  tests/journeys/keystore/changed/*.txt
  tests/journeys/native/*.c
  tests/journeys/native/*.toml
  tests/journeys/opensc/*.toml
  tests/journeys/opensc/*.txt
  tests/journeys/provision/*.toml
  tests/journeys/provision/*.txt
  tests/journeys/sunpkcs11/*.toml
  tests/journeys/sunpkcs11/*.cfg
  scripts/test-client-journeys.sh
source-repository head
  type:     git
  location: https://github.com/mingulov/haskoki

-- USDT observability probes (0.6.1): Latchset-compatible
-- crypto_auditing records plus the private haskoki provider.
-- Manual and default-off so source builds never depend on ambient
-- system headers; the official bundle, demo image, and the USDT CI
-- leg build with +usdt explicitly. On: compiles cbits/usdt.c and
-- defines HSK_USDT (needs <sys/sdt.h>, i.e. systemtap-sdt-dev;
-- the shim header fails clearly without it). Off: no probe path
-- at all (the C shim does not compile and every Haskell emitter
-- stubs out), though the Haskell-side hook calls still run with
-- no-op sinks, so both flag settings execute identical logic.
flag usdt
  description: Compile in USDT observability probes
  default:     False
  manual:      True

-- Omission classes are fatal in the pinned validation
-- configuration. Spellings confirmed by compiling probes on the pinned
-- GHC 9.10.3; flag names must come from compiled probes, never copied
-- from upstream docs alone. Scope: the library + test suites (what
-- run-gates.sh + forced builds validate).
common fatal-omissions
  ghc-options:
    -Werror=incomplete-patterns
    -Werror=incomplete-uni-patterns
    -Werror=incomplete-record-selectors
    -Werror=incomplete-record-updates
    -Werror=missing-fields
    -Werror=missing-methods

