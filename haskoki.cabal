cabal-version:      3.12
name:               haskoki
version:            0.3.0.0
synopsis:           Haskell PKCS#11 soft token (demonstrator)
description:
  A Haskell soft token that makes the PKCS#11 surface (APIs 2.40, 3.0, 3.1
  and 3.2) easy to exercise and understand. At 0.3.0.0: a C-loadable
  shared module with byte-pinned versioned tables, a mechanism catalog
  with 316 mechanisms tested of 464 catalog mechanisms, proven
  in-process through real libcrypto, native consumer
  and proxy-parity proofs, and a relocatable release artifact. The C
  tables route real crypto (sessions, objects, sign/verify,
  encrypt/decrypt, digest, wrap/unwrap, derive); genuinely
  unsupported calls refuse honestly. Not a conformance claim.
license:            Apache-2.0
license-file:       LICENSE
author:             haskoki contributors
maintainer:         haskoki contributors
category:           Security, Cryptography
build-type:         Simple
-- Supported compiler: GHC 9.10.3 (OS package or ghcup vanilla;
-- see docs/toolchain.md).
tested-with:       GHC == 9.10.3
extra-doc-files:
  README.md
  CHANGELOG.md
-- Source-package completeness: c-sources/.hs modules ship
-- automatically; everything else the build or the test suites read
-- (headers, generated .inc, spec inputs, fixtures, the catalog doc
-- one suite reads, the frozen build plan) is listed here so
-- `cabal sdist` unpacks to a buildable + testable tree. Verified by
-- unpacking the sdist outside the checkout and running the
-- docs/toolchain.md source-build recipe.
extra-source-files:
  cbits/*.h
  cbits/*.inc
  spec/*.json
  spec/*.txt
  spec/*.sql
  spec/vendor/*.h
  spec/planning/*.md
  spec/planning/*.csv
  tests/fixtures/*.der
  tests/fixtures/*.txt
  tests/ops/fixtures/*.toml
  tests/ops/fixtures/*.json
  tests/ops/fixtures/*.md
  docs/config-honesty.md
  cabal.project.freeze
source-repository head
  type:     git
  location: https://github.com/mingulov/haskoki

-- Omission classes are fatal in the pinned validation
-- configuration. Spellings confirmed by compiling probes on the pinned
-- GHC 9.10.3; flag names must come from compiled probes, never copied
-- from upstream docs alone. Scope: the library + test suites (what
-- run-gates.sh + forced builds validate).
common fatal-omissions
  ghc-options:
    -Werror=incomplete-patterns
    -Werror=incomplete-uni-patterns
    -Werror=incomplete-record-selectors
    -Werror=incomplete-record-updates
    -Werror=missing-fields
    -Werror=missing-methods

-- The pure core as a separate component. Dependency
-- direction is structural: this component depends on nothing
-- project-internal (external data libraries only); the main library,
-- the foreign library, and the test suites depend on it, never the
-- reverse. Visibility is private: the package's public API is the
-- main library alone.
