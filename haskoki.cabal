library
  import:           fatal-omissions
  exposed-modules:
    Haskoki
    Haskoki.Engine.Backend
    Haskoki.Engine.Driver
    Haskoki.Engine.OpenSSL4
    Haskoki.Engine.Synthetic
    Haskoki.Ctl
    Haskoki.FFI.Async
    Haskoki.FFI.Decode
    Haskoki.FFI.Encode
    Haskoki.FFI.Exports
    Haskoki.FFI.KeyOutputs
    Haskoki.FFI.MessageParams
    Haskoki.FFI.NativeParams
    Haskoki.FFI.Standard
    Haskoki.FFI.Notify
    Haskoki.FFI.Instance
    Haskoki.Runtime
    Haskoki.Runtime.Async
    Haskoki.Runtime.Config
    Haskoki.Runtime.Control
    Haskoki.Runtime.Detached
    Haskoki.Runtime.Events
    Haskoki.Runtime.Lifecycle
    Haskoki.Runtime.SlotEvents
    Haskoki.Runtime.Catalog
    Haskoki.Runtime.Storage
    Haskoki.Runtime.Storage.Memory
    Haskoki.Runtime.Storage.SQLite
    Haskoki.Runtime.Trace
    Haskoki.PKCS11
  -- Private provider-only OpenSSL 4 raw bindings (not a public API).
  other-modules:
    Haskoki.FFI.OpenSSL4.Raw
  -- Narrow ossl4 shim, linked against the pinned static libcrypto
  -- at $OPENSSL4_PREFIX (/opt/openssl-4.0.2 in the image; bind-mount the
  -- staged prefix there when building outside the rebuilt image).
  c-sources:
    cbits/ossl4_ctx.c
    cbits/notify_guard.c
  include-dirs:
    cbits
    spec/vendor
    /opt/openssl-4.0.2/include
  extra-lib-dirs:
    /opt/openssl-4.0.2/lib
  -- Exact-archive match: force the STATIC libcrypto.a even where the
  -- prefix also ships libcrypto.so (host lib64/). GNU ld -l:filename
  -- bypasses .so/.a search preference; both the container lib/ and
  -- the host lib64/ carry libcrypto.a, and this propagates to all
  -- dependent links (flib/exe/test) like plain -lcrypto did.
  extra-libraries:
    :libcrypto.a
  -- The pure core lives in core/ (single home of Haskoki.Types and
  -- the request/outcome/model contracts); src/ keeps the facade.
  -- The native decode/encode side lives in ffi/ but is wired
  -- through the library so model tests exercise it without a
  -- cross-component duplicate; the foreign library picks these
  -- modules up when export trampolines need them.
  -- core/ is the separate haskoki-core component (above);
  -- this library compiles src/ + ffi/ and depends on it.
  hs-source-dirs:   src ffi
  build-depends:
    base          >= 4.14 && < 5,
    bytestring    >= 0.10  && < 0.13,
    containers    >= 0.6   && < 0.9,
    direct-sqlite >= 2.3   && < 2.4,
    stm           >= 2.5   && < 2.6,
    text          >= 1.2   && < 2.2,
    unix          >= 2.7   && < 2.9,
    haskoki:haskoki-core
  ghc-options:      -Wall
  default-language: GHC2024

-- C-loadable provider module. Produces libhaskoki.so via the
-- threaded RTS (foreign-thread entry), DF_1_NODELETE linker pinning
-- (process-pinned embedding: dlclose must not unload Haskell code),
-- and the FFI export slice. No hs_exit anywhere in this package.
foreign-library haskoki
  type:             native-shared
  -- A1: the routed crypto exports pull the core/engine/runtime
  -- closure into the loadable module.
  -- Core modules come via haskoki:haskoki-core (below).
  hs-source-dirs:   src ffi
  other-modules:
    Haskoki.Engine.Backend
    Haskoki.Engine.Driver
    Haskoki.Engine.OpenSSL4
    Haskoki.FFI.Async
    Haskoki.FFI.Decode
    Haskoki.FFI.Encode
    Haskoki.FFI.Exports
    Haskoki.FFI.OpenSSL4.Raw
    Haskoki.FFI.NativeParams
    Haskoki.FFI.Standard
    Haskoki.FFI.Notify
    Haskoki.FFI.Instance
    Haskoki.FFI.Types
    Haskoki.Runtime.Async
    Haskoki.Runtime.Config
    Haskoki.Runtime.Control
    Haskoki.Runtime.Detached
    Haskoki.Runtime.Events
    Haskoki.Runtime.Lifecycle
    Haskoki.Runtime.SlotEvents
    Haskoki.Runtime.Catalog
    Haskoki.Runtime.Storage
    Haskoki.Runtime.Storage.Memory
    Haskoki.Runtime.Storage.SQLite
    Haskoki.Runtime.Trace
  c-sources:
    cbits/rts_bootstrap.c
    cbits/function_tables.c
    cbits/control_entry.c
    cbits/exports.c
    cbits/abi_probe.c
    cbits/ossl4_ctx.c
    cbits/notify_guard.c
    cbits/standard_surface.c
  -- Pinned PD 3.2 headers (declare all layouts + CK_C_* typedefs)
  -- for cbits/exports.c and ffi/Haskoki/FFI/Types.hsc. The mirror TU
  -- (function_tables.c) does not include them.
  -- Plus the pinned OpenSSL 4 headers; the module links the pinned
  -- static libcrypto ($OPENSSL4_PREFIX=/opt/openssl-4.0.2 in the image).
  include-dirs:
    spec/vendor
    /opt/openssl-4.0.2/include
  extra-lib-dirs:
    /opt/openssl-4.0.2/lib
  -- Exact-archive match: force the STATIC libcrypto.a even where the
  -- prefix also ships libcrypto.so (host lib64/). GNU ld -l:filename
  -- bypasses .so/.a search preference; both the container lib/ and
  -- the host lib64/ carry libcrypto.a, and this propagates to all
  -- dependent links (flib/exe/test) like plain -lcrypto did.
  extra-libraries:
    :libcrypto.a
  build-depends:
    base          >= 4.14 && < 5,
    bytestring    >= 0.10 && < 0.13,
    containers    >= 0.6  && < 0.9,
    direct-sqlite >= 2.3  && < 2.4,
    stm           >= 2.5  && < 2.6,
    text          >= 1.2  && < 2.2,
    unix          >= 2.7  && < 2.9,
    haskoki:haskoki-core >= 0.3 && < 0.4
  ghc-options:      -Wall -threaded
  cc-options:       -Wall -Wextra -std=c11 -pthread
  -- Relocatable bundle: resolve the bundled libHS* closure from the
  -- directory containing libhaskoki.so, so consumers need no
  -- LD_LIBRARY_PATH (dlopen honors this object's own RUNPATH).
  ld-options:       -Wl,-z,nodelete -Wl,-z,origin -pthread -Wl,-rpath,$ORIGIN
  default-language: GHC2024

-- Offline / owned-instance operator tool.
executable haskoki-ctl
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
    base     >= 4.14 && < 5,
    haskoki
  ghc-options:      -Wall -threaded
  -- NOTE: no ld-options here by design. This exe links fully static
  -- (Haskell libs + libcrypto.a inside; only system libc/libm/libgmp/
  -- libffi/libnuma NEEDED), so it needs no RUNPATH and no
  -- LD_LIBRARY_PATH anywhere it runs.
  default-language: GHC2024

-- Stale-handle injection probe (subprocess-isolated: every
-- stale use must answer CKR_CRYPTOKI_NOT_INITIALIZED). Test
-- jig, not a shipped tool: driven only by
-- scripts/test-lifecycle.sh.
executable lifecycle-probe
  main-is:          Main.hs
  hs-source-dirs:   tools/lifecycle-probe
  build-depends:
    base     >= 4.14 && < 5,
    haskoki
  ghc-options:      -Wall -threaded
  default-language: GHC2024

