  -- Narrow ossl4 shim, linked against the pinned static libcrypto
  -- at $OPENSSL4_PREFIX (/opt/openssl-4.1.0 in the image; bind-mount the
  -- staged prefix there when building outside the rebuilt image).
  c-sources:
    cbits/ossl4_ctx.c
    cbits/notify_guard.c
    cbits/table_mint.c
    cbits/context_registry.c
  include-dirs:
    cbits
    spec/vendor
    /opt/openssl-4.1.0/include
  extra-lib-dirs:
    /opt/openssl-4.1.0/lib
  -- Exact-archive match: force the STATIC libcrypto.a even where the
  -- prefix also ships libcrypto.so (host lib64/). GNU ld -l:filename
  -- bypasses .so/.a search preference; both the container lib/ and
  -- the host lib64/ carry libcrypto.a, and this propagates to all
  -- dependent links (flib/exe/test) like plain -lcrypto did.
  extra-libraries:
    :libcrypto.a
  -- The pure core lives in core/ (single home of Haskoki.Types and
  -- the request/outcome/model contracts); src/ keeps the
  -- implementation modules of this private library.
  -- The native decode/encode side lives in ffi/ but is wired
  -- through the library so model tests exercise it without a
  -- cross-component duplicate; the foreign library picks these
  -- modules up when export trampolines need them.
  -- core/ is the separate haskoki-core component (above);
  -- this library compiles src/ + ffi/ and depends on it.
  hs-source-dirs:   src ffi
  build-depends:
    base          >= 4.14 && < 5,
    bytestring    >= 0.10  && < 0.13,
    containers    >= 0.6   && < 0.9,
    direct-sqlite >= 2.3   && < 2.4,
    directory     >= 1.3   && < 1.4,
    filepath      >= 1.4   && < 1.6,
    stm           >= 2.5   && < 2.6,
    text          >= 1.2   && < 2.2,
    unix          >= 2.8   && < 2.9,
    haskoki:haskoki-core
  ghc-options:      -Wall
  -- Test configuration of the native shim (live-sets, fault gates,
  -- error seams). Defined here only: the foreign library (the shipped
  -- libhaskoki.so) never defines it.
  -- HSK_OSSL4_RETAIN_LIBCTX: closed envs keep their OSSL_LIB_CTX
  -- (providers still unload). This stops cross-thread stale DRBG
  -- state from outliving a freed, address-reused context (see
  -- hsk_ossl4_free_ctx). It lives here because this stanza compiles
  -- the shim for every test suite. A test-suite cc-options entry
  -- would not reach cbits/ossl4_ctx.c.
  cc-options:       -Wall -Wextra -std=c11 -pthread -DHSK_OSSL4_TEST_HOOKS -DHSK_OSSL4_RETAIN_LIBCTX
  cpp-options:      -DHSK_OSSL4_TEST_HOOKS
  if flag(usdt)
    cpp-options:  -DHSK_USDT
    cc-options:   -DHSK_USDT
    c-sources:    cbits/usdt.c
  default-language: GHC2024

-- C-loadable provider module. Produces libhaskoki.so via the
-- threaded RTS (foreign-thread entry), DF_1_NODELETE linker pinning
-- (process-pinned embedding: dlclose must not unload Haskell code),
-- and the FFI export slice. No hs_exit anywhere in this package.
