-- Buildable source-tree example: one checked rule (logout/object
-- lifetime) from user call to publication. Core-only, like the
-- core subset suite above: no runtime/FFI dependency. An
-- `executable` stanza (not `example`): the pinned cabal-install
-- 3.18 plans no `example` component (no such target type, absent
-- from `cabal build all`), so only an executable is buildable here.
executable logout-journey
  import:           fatal-omissions
  main-is:          LogoutJourney.hs
  hs-source-dirs:   examples/haskell-reference
  build-depends:
    base       >= 4.14 && < 5,
    bytestring >= 0.10 && < 0.13,
    containers >= 0.6  && < 0.9,
    haskoki:haskoki-core
  ghc-options:      -Wall -threaded
  default-language: GHC2024

-- Independent logout policy oracle plus one mechanism-variant KAT.
